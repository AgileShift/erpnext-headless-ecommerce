{
  "name": "erpnext-headless-ecommerce",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "audit:trust": "node scripts/audit-trust-readiness.mjs",
    "audit:trust:live": "node scripts/audit-live-trust.mjs",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "devhost": "vite --host"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-gtag": "^3.7.1",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@storefront-ui/tailwind-config": "^3.1.2",
    "@storefront-ui/vue": "^3.1.4",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tsconfig/node22": "^22.0.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.15.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-vue": "^10.12.1",
    "jsdom": "^31.0.1",
    "npm-run-all2": "^9.0.4",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.0",
    "vue-tsc": "3.3.3"
  },
  "overrides": {
    "vite-plugin-vue-devtools": {
      "vite-plugin-inspect": "^12.1.0"
    }
  }
